rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // MVP: a parent may only read/write their own user + child profile
    // document, keyed by their Firebase Auth UID. No public access.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Legacy (pre-multi-child) exploration records, kept only so old
      // data stays readable/migratable — same ownership model as the
      // parent doc. New writes always go under children/{childId} below.
      match /explorations/{explorationId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // A parent may only read/write their own children, and each child's
      // own exploration (experience session) records — same UID ownership
      // model, one level deeper. A sibling can never read another
      // sibling's data because both live under the same parent-owned path.
      match /children/{childId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;

        match /explorations/{explorationId} {
          allow read, write: if request.auth != null && request.auth.uid == userId;
        }
      }

      // FCM device tokens and login-notification events: same UID
      // ownership model — a parent only ever sees their own devices/events.
      // Cloud Functions (admin SDK) bypass these rules entirely to read
      // tokens and write notificationSent on explorations.
      match /fcmTokens/{tokenId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /notificationEvents/{eventId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Everything else is denied by default (no matching rule = no access).
  }
}
